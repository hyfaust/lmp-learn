# ============================================================
# LAMMPS 输入脚本: 真实单位 (Real Units)
# 模拟体系: 类氩流体 (Argon-like fluid) — 与 in.lj_units 相同的物理系统
# 单位制: real
# ============================================================
#
# 【real 单位制的含义】
# real 是分子动力学中最常用的单位制之一，尤其适合分子体系:
#   - 质量: g/mol (原子质量单位 × 阿伏伽德罗数)
#   - 距离: Å (埃，1 Å = 1e-10 m)
#   - 时间: fs (飞秒，1 fs = 1e-15 s)
#   - 能量: kcal/mol (千卡每摩尔)
#   - 速度: Å/fs
#   - 力: kcal/(mol·Å)
#   - 温度: K (开尔文)
#   - 压力: atm (标准大气压)
#
# 【与 LJ 单位的转换关系 (以氩为例)】
#   1σ = 3.405 Å          (氩原子的 LJ 直径)
#   1ε = 0.2381 kcal/mol  (ε/k_B = 119.8 K, ε = 119.8 × 1.987e-3 kcal/mol)
#   1m = 39.948 g/mol     (氩的原子量)
#   1τ = 2.157 ps         (LJ 时间单位 = σ√(m/ε))
#   T* = 1.0 对应 T = 119.8 K
#   dt = 0.005τ = 10.79 fs ≈ 10 fs
# ============================================================

# ---- 初始化 ----
clear

# ---- 单位制设定 ----
# real 单位制: g/mol, Å, fs, kcal/mol, K, atm
# 注意: 与 in.lj_units 中的 lj 不同，这里所有参数都要用有量纲的物理量
units real

# ---- 原子类型 ----
atom_style atomic

# ---- 模拟盒子 ----
# 与 in.lj_units 相同: 三个方向都是周期性边界
boundary p p p

# ---- 力场模型 ----
# LJ 势的截断半径
#   在 LJ 单位中 cutoff = 2.5 (即 2.5σ)
#   在 real 单位中 cutoff = 2.5 × 3.405 Å = 8.5125 Å
pair_style lj/cut 8.5125

# ---- 邻居列表 ----
# 皮肤距离: 0.3 × σ = 0.3 × 3.405 = 1.0215 Å ≈ 2.0 Å
# 这里用 2.0 Å 作为皮肤距离，合理范围内
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

# ---- 晶格与模拟盒子创建 ----
# 【重要】在 real 和 metal 单位制中，lattice 命令的参数是晶格常数 (lattice constant)，
# 而不是密度! 这与 lj 单位制不同 (lj 中参数是密度 ρ* = 0.8442 原子/σ³)。
#
# 晶格常数计算:
#   LJ 单位:  a_LJ = (4/ρ*)^(1/3) = (4/0.8442)^(1/3) ≈ 1.680σ
#   real 单位: a = a_LJ × σ = 1.680 × 3.405 Å ≈ 5.72 Å
#
# 所以 lattice 命令参数 = 5.72 (单位: Å)
lattice fcc 5.72

# 区域大小: 8 个晶格常数的边长
# 盒子边长 = 8 × 5.72 ≈ 45.8 Å
# 与 LJ 模拟中 8 × 1.68σ ≈ 13.4σ 物理上对应
region simbox block 0 8 0 8 0 8
create_box 1 simbox
create_atoms 1 box

# ---- 质量设定 ----
# real 单位中质量单位是 g/mol
# 氩的原子量 = 39.948 g/mol
mass 1 39.948

# ---- 力场参数 ----
# pair_coeff 类型i 类型j ε σ
#   ε = 119.8 K × k_B = 119.8 × 1.987e-3 kcal/mol = 0.2381 kcal/mol
#   σ = 3.405 Å (氩原子的 LJ 直径)
#
# 【重要提醒】
# LJ 单位中 pair_coeff 1 1 1.0 1.0 (无量纲)
# real 单位中 pair_coeff 1 1 0.2381 3.405 (有量纲)
# 但描述的是完全相同的物理相互作用!
pair_coeff 1 1 0.2381 3.405

# ---- 热力学输出设定 ----
thermo 100

# 输出热力学量 (注意单位都变了!)
#   temp:    温度 (K，开尔文)
#   press:   压力 (atm，标准大气压)
#   pe:      势能 (kcal/mol)
#   ke:      动能 (kcal/mol)
#   etotal:  总能量 (kcal/mol)
#   density: 质量密度 (g/cm³) — 注意! real 单位下 thermo 输出的是质量密度
thermo_style custom step temp press pe ke etotal density

# ---- 速度初始化 ----
# 目标温度 = 119.8 K (与 LJ 模拟中 T*=1.0 相同的物理温度)
velocity all create 119.8 12345 dist gaussian

# ---- 轨迹输出 ----
dump mydump all atom 100 dump_real.lammpstrj

# ---- 时间积分器 ----
fix 1 all nve

# ---- 时间步长 ----
# dt = 0.005τ ≈ 0.005 × 2157 fs ≈ 10 fs
# 在 real 单位中，timestep 的单位是 fs
# 使用 10.0 fs，与 LJ 模拟中的 0.005τ 物理上等价
timestep 10.0

# ---- 运行模拟 ----
# 1000 步 × 10 fs = 10 ps
# LJ 模拟中: 1000 步 × 0.005τ = 5τ ≈ 10.8 ps
# 两个模拟的物理时间基本相同 (10 ps vs 10.8 ps，差异来自四舍五入)
run 1000

# ============================================================
# 模拟结束
# 【对比 in.lj_units 的关键差异】
#
# 1. 所有数值参数都有量纲:
#    LJ:  pair_coeff 1 1 1.0 1.0     |  real: pair_coeff 1 1 0.2381 3.405
#    LJ:  mass 1 1.0                  |  real: mass 1 39.948
#    LJ:  timestep 0.005              |  real: timestep 10.0
#    LJ:  velocity create 1.0         |  real: velocity create 119.8
#    LJ:  cutoff 2.5                  |  real: cutoff 8.5125
#    LJ:  lattice fcc 0.8442 (密度)   |  real: lattice fcc 5.72 (晶格常数)
#
# 2. 热力学输出的数值完全不同 (单位不同):
#    LJ:  temp ≈ 1.0                  |  real: temp ≈ 119.8
#    LJ:  density ≈ 0.8442            |  real: density ≈ 1.40 (g/cm³)
#
# 3. 但物理结果是相同的!
#    - 温度比: 119.8/1.0 = 119.8 = ε/k_B ✓
#    - 原子排列结构相同 ✓
#    - 动力学行为相同 ✓
# ============================================================
