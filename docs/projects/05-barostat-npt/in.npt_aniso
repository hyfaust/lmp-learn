# ============================================================
#  LAMMPS 输入脚本：NPT 系综模拟 — 各向异性压力耦合
#  用途：演示各向异性（aniso）压力耦合与各向同性（iso）的差异
#  重点：三个方向的盒子尺寸独立变化，盒子形状可以改变
#  应用场景：晶体结构在不同应力下的响应、各向异性材料模拟
#  运行命令：lmp -in in.npt_aniso
# ============================================================

# ----------------------------------------------------------
# 第一部分：初始化设置
# ----------------------------------------------------------

units           lj
atom_style      atomic

# ----------------------------------------------------------
# 第二部分：体系定义 — 创建模拟盒子和原子
# ----------------------------------------------------------

# 创建立方体盒子
region          mybox block 0 10 0 10 0 10
create_box      1 mybox

# 使用 fcc 晶格，初始密度 ρ* = 0.8442
lattice         fcc 0.8442

# 创建原子
create_atoms    1 box

# ----------------------------------------------------------
# 第三部分：力场设置
# ----------------------------------------------------------

mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 1.0

# ----------------------------------------------------------
# 第四部分：初始条件
# ----------------------------------------------------------

# 初始速度对应 T* = 1.0
velocity        all create 1.0 12345 loop geom

timestep        0.005

# ----------------------------------------------------------
# 第五部分：NVT 预平衡
# 作用：在固定体积下先稳定温度
# 与 in.npt 相同，先做温度弛豫
# ----------------------------------------------------------

fix             nvt_fix all nvt temp 1.0 1.0 0.5

thermo          100
thermo_style    custom step temp press vol lx ly lz

print           "=========================================="
print           "  阶段一：NVT 预平衡 (5000 步)"
print           "=========================================="
run             5000

unfix           nvt_fix

# ----------------------------------------------------------
# 第六部分：各向异性 NPT 生产模拟
# 关键区别：使用 "aniso" 而非 "iso"
#
# iso vs aniso 的区别：
#
#   iso（各向同性）：
#   ┌──────────┐      ┌──────────┐
#   │          │      │ ┌──────┐ │
#   │          │  →   │ │      │ │
#   │          │      │ └──────┘ │
#   └──────────┘      └──────────┘
#   三个方向等比例缩放，盒子始终保持立方体
#
#   aniso（各向异性）：
#   ┌──────────┐      ┌────────────┐
#   │          │      │  ┌──────┐  │
#   │          │  →   │  │      │  │
#   │          │      │  └──────┘  │
#   └──────────┘      └────────────┘
#   三个方向独立缩放，盒子可以变成长方体
#   例如：x 方向拉伸，y 方向压缩
#
# 各向异性耦合的典型应用场景：
#   1. 晶体在单轴应力下的响应
#   2. 各向异性材料（如层状材料、纤维材料）
#   3. 确定非立方晶格的晶格参数（如 hcp、四方、六方）
#   4. 研究晶体的弹性性质
#   5. 模拟拉伸/压缩实验
#
# 注意：对于各向同性的液体，使用 aniso 时三个方向
#        在统计上应该给出相同的盒子尺寸（涨落不同）
#        这可以用来验证模拟是否正确
# ----------------------------------------------------------

# 各向异性 NPT 恒温恒压器
# 参数详解：
#   all         — 作用于所有原子
#   npt         — NPT 系综
#   temp 1.0 1.0 0.5
#     — 温度控制：T* = 1.0，T_damp = 0.5
#   aniso       — 各向异性压力耦合！
#     — 三个方向（x, y, z）各自独立地施加压力耦合
#     — 每个方向有自己的目标压力和弛豫速率
#   0.5 0.5 5.0
#     — 三个方向的目标压力均为 P* = 0.5
#     — 压力弛豫参数 P_damp = 5.0
#     — 如果需要，可以为不同方向指定不同压力
#       例如模拟单轴压缩：
#       fix 1 all npt temp 1.0 1.0 0.5 aniso 5.0 5.0 5.0
#       其中 x, y 方向用不同值实现非均匀应力
fix             1 all npt temp 1.0 1.0 0.5 aniso 0.5 0.5 5.0

# 重置时间步
reset_timestep  0

# 热力学输出：关键在于观察 lx, ly, lz 是否独立变化
thermo          100
thermo_style    custom step temp press vol lx ly lz density &
                pxx pyy pzz

# 轨迹输出
dump            myDump all custom 1000 dump.npt_aniso.lammpstrj &
                id type x y z vx vy vz
dump_modify     myDump sort id

# 记录各方向盒子尺寸随时间的变化
# 这是理解各向异性耦合的关键输出
fix             box_print all print 100 &
                "$(step) $(lx) $(ly) $(lz) $(vol) $(density)" &
                file box_dimensions.dat screen no &
                title "Step Lx Ly Lz Volume Density"

# 同时记录各方向的压力张量分量
# pxx, pyy, pzz 是压力张量的对角分量
# 在各向同性平衡态下，它们应该相等（对液体）
# 对于晶体或施加非均匀应力的系统，它们会不同
fix             press_print all print 100 &
                "$(step) $(press) $(pxx) $(pyy) $(pzz)" &
                file pressure_components.dat screen no &
                title "Step P_avg Pxx Pyy Pzz"

# 生产模拟：运行 50000 步
print           "=========================================="
print           "  阶段二：各向异性 NPT 生产模拟 (50000 步)"
print           "  温度: T* = 1.0"
print           "  压力: P* = 0.5 (各向异性)"
print           "  三个方向独立耦合"
print           "=========================================="
run             50000

# ----------------------------------------------------------
# 第七部分：统计分析
# ----------------------------------------------------------

print           "=========================================="
print           "  阶段三：统计平均 (额外 10000 步)"
print           "=========================================="

# 统计各方向盒子尺寸的平均值
variable        myLx equal lx
variable        myLy equal ly
variable        myLz equal lz
variable        rho equal density

fix             avg_lx all ave/time 10 100 1000 v_myLx file avg_lx.dat
fix             avg_ly all ave/time 10 100 1000 v_myLy file avg_ly.dat
fix             avg_lz all ave/time 10 100 1000 v_myLz file avg_lz.dat
fix             avg_density all ave/time 10 100 1000 v_rho file avg_density.dat

run             10000

# ----------------------------------------------------------
# 第八部分：输出最终结果
# ----------------------------------------------------------

print           "=========================================="
print           "  各向异性 NPT 模拟完成！"
print           "=========================================="
print           "  最终盒子尺寸:"
print           "    Lx = $(lx)"
print           "    Ly = $(ly)"
print           "    Lz = $(lz)"
print           "  最终温度: $(temp)"
print           "  最终压力: $(press)"
print           "  最终密度: $(density)"
print           "  各方向压力张量:"
print           "    Pxx = $(pxx)"
print           "    Pyy = $(pyy)"
print           "    Pzz = $(pzz)"
print           "=========================================="
print           "  输出文件说明："
print           "    dump.npt_aniso.lammpstrj — 轨迹文件"
print           "    box_dimensions.dat       — 盒子尺寸随时间变化"
print           "    pressure_components.dat  — 压力张量分量"
print           "    avg_lx/ly/lz.dat         — 各方向平均尺寸"
print           "    avg_density.dat          — 平均密度"
print           "=========================================="
print           "  提示：对各向同性液体，Lx≈Ly≈Lz（统计上）"
print           "        如有明显差异，可能需要更长的平衡时间"
print           "=========================================="

# 保存重启文件
write_restart   restart.npt_aniso
