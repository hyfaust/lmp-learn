# ============================================================
#  LAMMPS 输入脚本：NPT 系综模拟 — 各向同性压力耦合
#  用途：演示 Nosé-Hoover 恒温恒压器（NPT 系综）的使用方法
#  系统：Lennard-Jones 液体，从初始晶格出发，先 NVT 弛豫，再 NPT 平衡
#  运行命令：lmp -in in.npt
# ============================================================

# ----------------------------------------------------------
# 第一部分：初始化设置
# ----------------------------------------------------------

# 使用 LJ 约化单位制（m = σ = ε = k_B = 1）
units           lj

# 原子样式为 atomic（无键接信息）
atom_style      atomic

# ----------------------------------------------------------
# 第二部分：体系定义 — 创建模拟盒子和原子
# ----------------------------------------------------------

# 创建一个边长约为 10σ 的立方体盒子
region          mybox block 0 10 0 10 0 10
create_box      1 mybox

# 使用 fcc 晶格，初始密度 ρ* = 0.8442
# 这是 LJ 液体的经典参考密度，对应三相点附近的液态
lattice         fcc 0.8442

# 在盒子内按晶格排列创建原子
create_atoms    1 box

# ----------------------------------------------------------
# 第三部分：力场设置
# ----------------------------------------------------------

# 原子质量 = 1（LJ 单位制）
mass            1 1.0

# LJ 势，截断半径 2.5σ
pair_style      lj/cut 2.5

# 势参数：ε = 1.0，σ = 1.0
pair_coeff      1 1 1.0 1.0 1.0

# ----------------------------------------------------------
# 第四部分：初始条件
# ----------------------------------------------------------

# 给原子分配初始速度，目标温度 T* = 1.0
# 这是本模拟的目标温度（也是后续 NPT 的目标温度）
velocity        all create 1.0 12345 loop geom

# ----------------------------------------------------------
# 第五部分：时间步长
# ----------------------------------------------------------

# 时间步长 0.005，LJ 液体模拟中的常用值
timestep        0.005

# ----------------------------------------------------------
# 第六部分：第一阶段 — NVT 预平衡（Nosé-Hoover 恒温器）
# 作用：在固定体积下先让系统达到目标温度
# 为什么需要这一步？
#   - 初始晶格结构的势能很高，直接开 NPT 可能导致体积剧烈变化
#   - 先在 NVT 下稳定温度，再引入压力控制更加平稳
# ----------------------------------------------------------

# Nosé-Hoover 恒温器
# 参数详解：
#   all         — 作用于所有原子
#   nvt         — NVT 系综（粒子数 N、体积 V、温度 T 固定）
#   temp T_lo T_hi T_damp
#     1.0       — 起始温度 T* = 1.0
#     1.0       — 终止温度 T* = 1.0（恒温，不变化）
#     0.5       — 温度弛豫时间参数 T_damp = 0.5
#                 控制恒温器"调节"温度的速度
#                 一般取 100*dt ~ 200*dt，此处 0.5 = 100 * 0.005
fix             nvt_fix all nvt temp 1.0 1.0 0.5

# 热力学输出：每 100 步
thermo          100
thermo_style    custom step temp press vol lx ly lz density

# NVT 预平衡阶段：运行 5000 步
# 总时间 = 5000 × 0.005 = 25τ
# 这段时间足够让温度基本稳定在目标值附近
print           "=========================================="
print           "  阶段一：NVT 预平衡 (5000 步)"
print           "=========================================="
run             5000

# 取消 NVT 的 fix，为切换到 NPT 做准备
unfix           nvt_fix

# ----------------------------------------------------------
# 第七部分：第二阶段 — NPT 生产模拟
# 作用：在恒温恒压条件下运行，系统密度将自动调整到平衡值
# ----------------------------------------------------------

# Nosé-Hoover 恒温恒压器（各向同性）
# 参数详解：
#   all         — 作用于所有原子
#   npt         — NPT 系综（粒子数 N、压力 P、温度 T 固定）
#   temp T_lo T_hi T_damp
#     1.0 1.0   — 温度保持在 T* = 1.0
#     0.5       — 温度弛豫参数（同上）
#   iso         — 各向同性压力耦合（三个方向同步缩放）
#   P_lo P_hi P_damp
#     0.5 0.5   — 压力目标为 P* = 0.5（恒定）
#     5.0       — 压力弛豫参数 P_damp = 5.0
#                 控制体积调整的速度
#                 一般取 1000*dt ~ 10000*dt，此处 5.0 = 1000 * 0.005
fix             1 all npt temp 1.0 1.0 0.5 iso 0.5 0.5 5.0

# 重置时间步计数器，使输出从 0 开始（方便分析 NPT 阶段）
reset_timestep  0

# 热力学输出：每 100 步
thermo          100
thermo_style    custom step temp press vol lx ly lz density

# 轨迹文件：每 1000 步输出一帧
# 记录原子坐标和速度，便于可视化和后期分析
dump            myDump all custom 1000 dump.npt.lammpstrj id type x y z vx vy vz
dump_modify     myDump sort id

# 用于计算平均密度的变量
# v_vol  — 获取当前盒子体积（LAMMPS 内置 thermo 关键字 vol）
# density 等效于 N / vol
# c_thermo_temp, c_thermo_press, c_thermo_vol 是 compute thermo 的结果
# 我们用变量来收集密度的累加和，以便最后计算平均值
variable        rho equal density
variable        myTemp equal temp
variable        myPress equal press
variable        myVol equal vol
variable        myLx equal lx
variable        myLy equal ly
variable        myLz equal lz

# 创建一个用于统计平均密度的变量
# equal 类型变量每次调用时计算
variable        sum_rho equal 0.0
variable        n_count equal 0

# 每 100 步将当前密度写入密度历史文件
# 使用 fix print 定期输出密度值
fix             density_print all print 100 "$(step) $(density) $(temp) $(press) $(vol)" &
                file density_history.dat screen no &
                title "Step Density Temperature Pressure Volume"

# NPT 生产模拟：运行 50000 步
# 总时间 = 50000 × 0.005 = 250τ
print           "=========================================="
print           "  阶段二：NPT 生产模拟 (50000 步)"
print           "  温度: T* = 1.0"
print           "  压力: P* = 0.5 (各向同性)"
print           "  P_damp = 5.0"
print           "=========================================="
run             50000

# ----------------------------------------------------------
# 第八部分：统计分析 — 计算平均密度
# ----------------------------------------------------------

# 使用 compute 和 fix ave/time 来计算后半程的平均密度
# 后半程（后 25000 步）系统通常已达到平衡，用于统计更有意义
# 等间隔采样：每 10 步采一次，每 2500 步输出一个平均值

# 删除之前的 density_print fix（避免重复输出）
unfix           density_print

# 用 fix ave/time 统计后半程（25000~50000 步）的平均值
# mode: 每 Nrepeat 个样本输出一次平均
# Nrepeat: 2500 个样本 → 25000 步 / 10 = 2500
# Nevery: 每 10 步采一个点
# Nfreq: 每 25000 步输出一次（即只在模拟结束时输出一次）
# 但由于 run 只有 50000 步，我们在 run 之前就挂上 fix
# 我们换个思路：先跑完，然后用第二段来统计

# 在 NPT 运行结束后，继续短时间运行来做统计
# 或者我们用另一种方式：利用 LAMMPS 的变量累加功能

# 重置时间步，从 NPT 平衡的后半段开始统计
# 实际上，我们在 run 50000 之后，可以利用 fix ave/time
# 但更简单的方法是使用 LAMMPS 的 log 文件分析

# 替代方案：使用 compute 来计算平均
# 在 LAMMPS 中，最方便的方式是通过 thermo 输出的 log 文件来计算
# 但为了在脚本中直接得到结果，我们使用变量累加

# 重新挂上输出 fix，用于后半段统计
# 我们再额外运行 10000 步专门做统计（系统已平衡）
print           "=========================================="
print           "  阶段三：统计平均密度 (额外 10000 步)"
print           "  (系统已平衡，用于精确统计)"
print           "=========================================="

# 使用 fix ave/time 统计密度
fix             avg_density all ave/time 10 100 1000 v_rho &
                file avg_density.dat

# 统计温度和压力的平均值
fix             avg_temp all ave/time 10 100 1000 v_myTemp &
                file avg_temp.dat
fix             avg_press all ave/time 10 100 1000 v_myPress &
                file avg_press.dat

# 统计盒子尺寸的平均值
fix             avg_box all ave/time 10 100 1000 &
                v_myLx v_myLy v_myLz &
                file avg_box.dat

run             10000

# ----------------------------------------------------------
# 第九部分：输出最终结果
# ----------------------------------------------------------

# 打印最终盒子信息
print           "=========================================="
print           "  NPT 模拟完成！"
print           "=========================================="
print           "  最终温度: $(temp)"
print           "  最终压力: $(press)"
print           "  最终体积: $(vol)"
print           "  最终密度: $(density)"
print           "  盒子尺寸: lx=$(lx)  ly=$(ly)  lz=$(lz)"
print           "=========================================="
print           "  输出文件说明："
print           "    dump.npt.lammpstrj  — 轨迹文件（可视化用）"
print           "    density_history.dat — 密度随时间变化"
print           "    avg_density.dat     — 平均密度统计"
print           "    avg_temp.dat        — 平均温度统计"
print           "    avg_press.dat       — 平均压力统计"
print           "    avg_box.dat         — 平均盒子尺寸"
print           "    log.lammps          — 完整日志（含热力学数据）"
print           "=========================================="

# 保存最终状态的重启文件
write_restart   restart.npt
