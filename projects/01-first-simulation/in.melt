# ============================================================
#  LAMMPS 输入脚本：第一个模拟 — Lennard-Jones 熔化
#  用途：演示基本的分子动力学模拟流程
#  运行命令：lmp -in in.melt
# ============================================================

# ----------------------------------------------------------
# 第一部分：初始化设置
# 作用：定义模拟的基本单位制和原子类型
# ----------------------------------------------------------

# 使用 Lennard-Jones（LJ）约化单位制
# 在此单位制下，m = σ = ε = k_B = 1，所有物理量均为无量纲数
units           lj

# 设置原子样式为 "atomic"，即每个原子只有位置和速度等基本属性
# 不需要定义电荷、键角等信息，适合单原子系统
atom_style      atomic

# ----------------------------------------------------------
# 第二部分：体系定义 — 创建模拟盒子和原子
# 作用：搭建模拟的"舞台"（盒子）和"演员"（原子）
# ----------------------------------------------------------

# 定义一个长方体区域，名称为 "mybox"
# block xlo xhi ylo yhi zlo zhi
# 这里创建一个边长约为 10σ 的立方体盒子（σ 为 LJ 长度单位）
region          mybox block 0 10 0 10 0 10

# 用上面定义的区域创建模拟盒子
# "1" 表示只有一种原子类型
# create_box 后会初始化一个空盒子
create_box      1 mybox

# 设置晶格类型和密度
# fcc = 面心立方晶格（最常见的金属晶体结构之一）
# 0.8442 是 LJ 约化密度（ρ* = 0.8442），对应液态三相点附近的密度
# 这个密度值是 LJ 模拟中的经典参考值
lattice         fcc 0.8442

# 在整个盒子内按上面设置的晶格创建原子
# LAMMPS 会自动根据晶格密度和盒子大小计算原子数量
create_atoms    1 box

# ----------------------------------------------------------
# 第三部分：力场设置 — 定义原子之间的相互作用
# 作用：告诉 LAMMPS 原子之间如何"推"和"拉"
# ----------------------------------------------------------

# 设置原子质量
# 参数：类型编号  质量值
# 在 LJ 单位制下，质量 = 1（即 m = 1.0）
mass            1 1.0

# 设置对势（pair style）为 Lennard-Jones 势，截断半径为 2.5σ
# lj/cut 表示在截断距离处直接截断势函数（不做平滑修正）
# 2.5σ 是 LJ 模拟中最常用的截断半径，兼顾精度和效率
pair_style      lj/cut 2.5

# 设置不同原子类型之间的对势参数
# 参数：类型i  类型j  ε（势阱深度）  σ（粒子直径）
# ε = 1.0：势阱深度为 1 个能量单位（即 k_B*T 参考量）
# σ = 1.0：原子直径为 1 个长度单位
# 截断半径沿用 pair_style 中设置的 2.5σ
pair_coeff      1 1 1.0 1.0

# ----------------------------------------------------------
# 第四部分：初始条件设置
# 作用：给原子一个初始速度（温度）
# ----------------------------------------------------------

# 按照指定温度给原子分配初始速度
# 参数：  all         — 选中所有原子
#         create      — 从零开始创建速度（而非修改已有速度）
#         1.44        — 目标温度 T* = 1.44（LJ 约化温度）
#         87287       — 随机数种子（不同种子 → 不同初始速度分布）
#         loop geom   — 几何循环方式分配速度，确保总动量为零
# T* = 1.44 高于 LJ 体系的临界温度，因此系统将处于超临界流体状态
velocity        all create 1.44 87287 loop geom

# ----------------------------------------------------------
# 第五部分：输出设置
# 作用：控制模拟过程中输出哪些信息
# ----------------------------------------------------------

# 每隔 100 步输出一次热力学统计量（温度、能量、压强等）
thermo          100

# 自定义热力学输出列
# Step   — 当前时间步
# Temp   — 温度（由原子动能计算得出）
# E_pair — 对势能（原子间相互作用的势能）
# E_mol  — 分子势能（本例中无键接作用，始终为 0）
# TotEng — 总能量（动能 + 势能，应近似守恒）
# Press  — 体系压强
thermo_style    custom step temp epair emol etotal press

# 轨迹文件输出：每 100 步写一帧
# 参数说明：
#   all                — 输出所有原子
#   100                — 输出频率（每 100 步一次）
#   dump.melt.lammpstrj — 输出文件名（XYZ 格式）
#   id     — 原子编号
#   type   — 原子类型
#   x y z  — 原子坐标
#   vx vy vz — 原子速度分量
dump            myDump all custom 100 dump.melt.lammpstrj id type x y z vx vy vz

# 设置每帧输出的文件包含原子坐标信息
dump_modify     myDump sort id

# ----------------------------------------------------------
# 第六部分：运行模拟
# 作用：执行分子动力学积分，推进体系的时间演化
# ----------------------------------------------------------

# 添加 NVE 积分器——这是让原子"动起来"的关键！
# "fix" 是 LAMMPS 中用于在每一步执行特定操作的命令
# "1" 是这个 fix 的编号（可以任意，但不能与其他 fix 重复）
# "all" 表示作用于所有原子
# "nve" 表示使用 Velocity-Verlet 积分算法，维持 NVE 系综
#   （粒子数 N 不变、体积 V 不变、能量 E 近似守恒）
# 没有这个 fix，原子不会运动！
fix             1 all nve

# 设置时间步长为 0.005（LJ 时间单位）
# LJ 时间单位 τ = σ√(m/ε)，当 m=σ=ε=1 时，τ = 1
# 0.005τ 是 LJ 液体模拟中常用的步长，过大会导致能量不守恒
timestep        0.005

# 运行 10000 步，总模拟时间 = 10000 × 0.005 = 50τ
run             10000

# ----------------------------------------------------------
# 第七部分：保存重启文件
# 作用：将最终状态写入文件，便于后续续算或分析
# ----------------------------------------------------------

# 写入二进制重启文件
# 重启文件包含完整信息（坐标、速度、盒子大小等），可以精确续算
write_restart   restart.melt
