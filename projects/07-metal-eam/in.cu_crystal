# ============================================================
# 铜晶体的分子动力学模拟
# Copper Crystal Molecular Dynamics Simulation
# ============================================================
#
# 本脚本模拟 FCC 铜晶体在 300K、常压下的行为
# 使用简化的 Lennard-Jones 势作为示例（自包含，可直接运行）
#
# 关于势函数的选择:
#   - 本示例使用 lj/cut 势，参数近似描述铜（ε=0.343 eV, σ=2.54 Å）
#   - 对于真实的研究模拟，应使用 EAM 势（嵌入原子法），例如:
#     pair_style eam
#     pair_coeff * * Cu_u3.eam
#   - EAM 势函数文件可从 https://www.ctcms.nist.gov/potentials/ 下载
#   - EAM 能更准确地描述金属的多体相互作用

# ----- 初始化 -----
# 清除之前的所有设置，确保从干净的状态开始
clear

# ----- 单位设置 -----
# units metal: 金属体系常用单位
#   - 距离: 埃（Angstrom, Å）
#   - 能量: 电子伏特（eV）
#   - 时间: 皮秒（ps）
#   - 温度: 开尔文（K）
#   - 压力: 巴（bar）
#   - 质量: 克/摩尔（g/mol）
units metal

# ----- 原子样式 -----
# atom_style atomic: 最简单的原子样式，每个原子只有质量、坐标
# 适用于金属等不带电荷的体系
# 其他样式如 charge（带电荷）、molecular（分子）等以后会学到
atom_style atomic

# ----- 晶格定义 -----
# lattice fcc 3.615: 定义面心立方（FCC）晶格
#   - fcc: 面心立方结构类型
#   - 3.615: 铜的晶格常数，单位为 Å（埃）
#   - FCC 结构中每个晶胞有 4 个原子
#   - 晶格常数 a 与原子半径 r 的关系: a = 2√2 · r
#     对于铜: r ≈ 1.28 Å, a ≈ 3.615 Å
lattice fcc 3.615

# ----- 创建模拟盒子 -----
# region box block: 定义一个长方体区域
#   - xlo xhi ylo yhi zlo zhi: 各方向的边界
#   - 这里 0 到 10 表示 10 个晶格单位
#   - 单位是晶格常数的倍数，所以实际大小 = 10 × 3.615 ≈ 36.15 Å
#   - units lattice: 表示使用晶格单位（而非实际距离单位）
region box block 0 10 0 10 0 10 units lattice

# create_box: 在定义的区域内创建模拟盒子
#   - 1: 原子类型数（本例只有铜，1种类型）
#   - box: 使用上面定义的区域
create_box 1 box

# create_atoms: 在盒子中填充原子
#   - 1: 原子类型编号（对应上面的类型数）
#   - box: 在整个盒子内按晶格排列填充
#   - 总原子数 = 10 × 10 × 10 × 4 = 4000 个
create_atoms 1 box

# ----- 质量设置 -----
# 设置类型1原子的质量为 63.546 g/mol（铜的原子量）
mass 1 63.546

# ----- 力场设置 -----
# 使用 Lennard-Jones 12-6 势（简化模型）
# pair_style lj/cut 4.0: 截断距离为 4.0 Å
#   - LJ 势公式: V(r) = 4ε[(σ/r)^12 - (σ/r)^6]
#   - ε: 势阱深度（能量尺度）
#   - σ: 零势能距离（长度尺度）
#   - cut: 超过此距离的相互作用被忽略
#
# pair_coeff 1 1 0.343 2.54: 类型1-类型1的 LJ 参数
#   - ε = 0.343 eV（铜的近似值，在 metal 单位下）
#   - σ = 2.54 Å（铜的近似值）
#   - 注意: LJ 势只是铜的粗糙近似！
#     真实模拟应使用 EAM 势:
#     pair_style eam
#     pair_coeff * * Cu_u3.eam
pair_style lj/cut 4.0
pair_coeff 1 1 0.343 2.54

# ----- 邻居列表设置 -----
# neighbor: 设置皮肤距离（skin distance）
#   - 2.0 Å: 邻居列表的额外搜索半径
#   - 当原子移动超过 skin 距离时，才重建邻居列表
#   - 提高计算效率（减少邻居列表更新频率）
neighbor 2.0 bin

# ----- 输出设置 -----
# thermo 100: 每 100 步输出一次热力学信息
thermo 100

# thermo_style: 定义输出哪些热力学量
#   - step: 当前步数
#   - temp: 温度（K）
#   - pe: 势能（eV）
#   - ke: 动能（eV）
#   - etotal: 总能量（eV）
#   - press: 压力（bar）
#   - vol: 体积（Å³）
#   - lx: 盒子在 x 方向的长度（Å）
#   - density: 密度（g/cm³）
thermo_style custom step temp pe ke etotal press vol lx density

# ----- 轨迹输出 -----
# dump: 输出原子轨迹，可用 OVITO 等软件可视化
#   - myDump: dump 的名称标识
#   - all: 所有原子
#   - atom: 输出原子坐标（也可以用 custom 自定义输出内容）
#   - 100: 每 100 步输出一帧
#   - cu_crystal.lammpstrj: 输出文件名
#   - 输出格式为 LAMMPS dump 格式，OVITO 原生支持
dump myDump all atom 100 cu_crystal.lammpstrj

# ============================================================
# 阶段一：能量最小化（弛豫）
# ============================================================
# 先进行能量最小化，消除原子间的严重重叠
# 这相当于让晶体"放松"到最稳定的状态
# minimize: 最速下降法进行能量最小化
#   - 1.0e-4: 能量变化收敛标准（eV）
#   - 1.0e-6: 力的收敛标准（eV/Å）
#   - 1000: 最大步数
#   - 10000: 最大评估次数
print "===== 阶段一：能量最小化 ====="
minimize 1.0e-4 1.0e-6 1000 10000

# ============================================================
# 阶段二：NPT 系综平衡
# ============================================================
# NPT 系综: 粒子数 N、压力 P、温度 T 恒定
# 这是最接近实验条件的系综

# timestep: 设置时间步长
#   - 0.001 ps = 1 飞秒（fs）
#   - 金属体系通常使用 1-2 fs 的时间步长
timestep 0.001

# fix npt: 施加 NPT 恒温恒压控制
#   - myNPT: fix 的名称
#   - all: 作用于所有原子
#   - npt: NPT 系综
#   - temp 300 300 0.1: 温度控制
#     - 300: 起始温度（K）
#     - 300: 终止温度（K）
#     - 0.1: 温度阻尼参数（ps），控制温度调节的速度
#   - iso 0 0 1.0: 各向同性压力控制
#     - 0: 起始压力（bar）
#     - 0: 终止压力（bar）
#     - 1.0: 压力阻尼参数（ps）
#   - iso = 各向同性（x, y, z 方向同时调节）
#   - aniso = 各向异性（各方向独立调节）
fix myNPT all npt temp 300 300 0.1 iso 0 0 1.0

# ----- 平衡阶段的输出 -----
# 每 100 步记录晶格常数（x 方向盒子长度 / 单元格数）
# variable: 定义一个变量
#   - lat: 变量名
#   - equal: 计算表达式
#   - lx/10.0: x方向盒子长度除以10（单元格数），得到晶格常数
variable lat equal lx/10.0

# fix ave/time: 时间平均输出
#   - myAve: fix 名称
#   - 1: 每步都计算
#   - 10: 每 10 步取一次平均
#   - 100: 每 100 步输出一次
#   - v_lat: 要平均的变量
#   - file lattice.dat: 输出到文件
#   - mode scalar: 标量模式
fix myAve all ave/time 1 10 100 v_lat file lattice.dat mode scalar

# ----- 运行平衡 -----
# run 10000: 运行 10000 步
#   - 10000 步 × 0.001 ps/步 = 10 ps 的模拟时间
print "===== 阶段二：NPT 平衡 (300K, 0 bar) ====="
run 10000

# ============================================================
# 阶段三：分析与输出
# ============================================================

# 输出最终的晶格常数
# 从平衡后的盒子尺寸计算晶格常数
# 在 FCC 结构中，10 个晶格常数 = 盒子 x 方向长度
print "=========================================="
print "        模拟结果分析"
print "=========================================="
print "初始晶格常数: 3.615 Å（铜）"

# 使用 thermo 输出最终状态的量
# 我们也可以用 variable 来计算
variable final_lat equal lx/10.0
variable final_vol equal vol
variable n_atoms equal count(all)
variable density_gcm3 equal density

# run 0: 不运行新步数，只触发当前步的输出
# （让 thermo 输出当前状态）
run 0

print "=========================================="
print "模拟完成！"
print "查看轨迹文件: cu_crystal.lammpstrj"
print "查看晶格常数变化: lattice.dat"
print "=========================================="
print ""
print "提示："
print "  1. 用 OVITO 打开 cu_crystal.lammpstrj 可视化原子轨迹"
print "  2. 用 gnuplot 或 Python 绘制 lattice.dat 查看晶格常数随时间的变化"
print "  3. 真实研究中请使用 EAM 势函数以获得更准确的结果"
print "     下载地址: https://www.ctcms.nist.gov/potentials/"
