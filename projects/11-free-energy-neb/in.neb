# =============================================================================
# in.neb — NEB（Nudged Elastic Band）计算输入脚本
# =============================================================================
# 运行方式（使用 MPI 并行，每个副本占一个进程）：
#
#   mpirun -np 4 lmp -in in.neb
#
# 说明：
#   - 4 表示使用 4 个 MPI 进程，即 4 个"映像"（image/replica）
#   - 每个进程负责计算路径上的一个中间构型
#   - 映像数应大于等于 3：初始态 + 至少一个中间态 + 末态
#   - 第一个进程 = 初始态（固定），最后一个进程 = 末态（固定）
#   - 中间进程 = 待优化的中间构型
#
# 需要的文件（由 in.neb_setup 生成）：
#   data.initial — 初始态原子构型
#   data.final   — 末态原子构型
# =============================================================================

# ----------------------------- 初始化设置 ------------------------------------
# 使用 LJ 无量纲单位
units           lj
# 原子样式：基本的点粒子
atom_style      atomic
# 使用 Lennard-Jones 势，截断半径 2.5 sigma
pair_style      lj/cut 2.5
# 三维周期性边界
boundary        p p p

# ----------------------------- 读取初始构型 ----------------------------------
# read_data 读取 data.initial 文件
#   第一个进程（replica 0）读取 data.initial 作为起始构型
#   最后一个进程（replica N-1）读取 data.final 作为终止构型
#   中间进程通过线性插值生成初始构型
#
# LAMMPS 的 NEB 实现中：
#   - 主进程读 data.initial
#   - 其他副本通过 fix neb 自动读取 data.final 并做插值
# 因此这里只需要读 data.initial
read_data       data.initial

# 定义势能参数（与 in.neb_setup 保持一致）
pair_coeff      1 1 1.0 1.0 2.5
mass            1 1.0

# ----------------------------- 邻居列表设置 ----------------------------------
# NEB 计算中每个映像都需要构建邻居列表
# 每 1 步更新一次邻居列表（保证精度）
# skin = 0.3：邻居列表的"皮肤"厚度（LJ 单位）
neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

# ----------------------------- NEB 专用设置 ----------------------------------
# 注意：data.final 文件通过 fix neb 的最后一个参数指定
# 或者需要为最后一个 replica 单独读取 data.final
#
# 运行方式：mpirun -np 4 lmp -in in.neb
# 第一个 replica 读取 data.initial，最后一个 replica 读取 data.final
# 中间 replica 通过线性插值生成

# ----------------------------- 输出设置 --------------------------------------
# 每 10 步输出热力学信息
thermo          10
# 输出内容：步数、势能、每原子能量、最大力
thermo_style    custom step pe ke etotal temp

# 每个 replica 输出自己的轨迹文件
#   dump.N 表示第 N 个 replica 的轨迹
#   用于分析路径上每个映像的原子运动
dump            neb_dump all custom 10 dump.neb.*.lammpstrj id type x y z

# ----------------------------- 最小化参数 ------------------------------------
# NEB 本质上是一系列受限最小化问题
# min_style 设置优化算法
#   cg（共轭梯度法）：适合 NEB，因为它能处理带约束的优化
min_style       cg

# ----------------------------- fix neb 命令 ---------------------------------
# fix neb 是 LAMMPS 中 NEB 方法的核心实现
#
# 命令格式：
#   fix ID group-ID neb spring_constant
#
# 参数说明：
#   neb_fix:           fix 的 ID（名称）
#   all:               作用于所有原子
#   neb:               使用 NEB 方法
#   1.0:               弹簧常数（spring constant, k）
#
# 弹簧常数 k 的物理意义：
#   - 连接相邻映像的虚拟弹簧的弹性系数
#   - k 越大 → 弹簧越硬 → 映像间距离更均匀
#   - k 越小 → 弹簧越软 → 映像可能聚集在能量低的区域
#   - 通常取 1.0 ~ 10.0（LJ 单位），需要根据具体问题调整
#   - 过大的 k 可能导致数值不稳定
#
# NEB 的"微调"（Nudge）含义：
#   在标准弹性带方法中，弹簧力和真实力都作用在映像上
#   "Nudge"操作将力分解为两个分量：
#     - 沿路径切线方向的分量：只保留弹簧力（防止映像聚集）
#     - 垂直于路径切线方向：只保留真实力（推向真正的最小能量路径）
#   这样做的好处是：消除映像沿路径滑动的问题，使路径收敛到最小能量路径（MEP）
fix             neb_fix all neb 1.0

# ----------------------------- NEB 最小化 ------------------------------------
# minimize 命令在 NEB 模式下执行受限最小化
#
# 参数说明：
#   0.0          — 能量变化收敛阈值（0 表示不使用能量收敛判据）
#   1.0e-6       — 力的收敛阈值（最大原子力 < 1e-6 时认为收敛）
#   1000         — 最大迭代步数（每步 = 所有映像的一次力计算）
#   10000        — 最大函数评估次数
#
# 收敛过程：
#   每一步中，所有映像同时计算势能和力
#   fix neb 根据 NEB 算法对力进行修正（nudge 操作）
#   所有映像沿修正后的力方向移动
#   重复直到力收敛或达到最大步数
minimize        0.0 1.0e-6 1000 10000

# ----------------------------- 输出结果 --------------------------------------
# NEB 完成后，LAMMPS 会自动输出：
#   1. 每个映像的势能
#   2. 路径上的最大能量（过渡态能量）
#   3. 激活能 = 过渡态能量 - 初始态能量
#
# 这些信息会在 thermo 输出中显示
# 注意：NEB 结果中 pe 就是该映像的势能

# 清除 fix
unfix           neb_fix

# 清除 dump
undump          neb_dump

# 输出最终信息
print           ""
print           "============================================"
print           "  NEB 计算完成！"
print           "  请查看上方输出中各映像的势能值"
print           "  激活能 = 最高能量映像 - 初始态能量"
print           "  过渡态 = 能量最高点对应的构型"
print           "============================================"
