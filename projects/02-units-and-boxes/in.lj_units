# ============================================================
# LAMMPS 输入脚本: LJ 约化单位 (Lennard-Jones Reduced Units)
# 模拟体系: 类氩流体 (Argon-like fluid)
# 单位制: lj
# ============================================================
#
# 【什么是 LJ 约化单位?】
# LJ 单位以 Lennard-Jones 势的参数为基础进行无量纲化:
#   - 长度单位 σ = 3.405 Å (氩原子直径)
#   - 能量单位 ε = 1.654e-21 J (对应 119.8 K 的热能)
#   - 质量单位 m = 39.948 amu (氩原子质量)
#   - 玻尔兹曼常数 k_B = 1 (温度 T* = k_B*T/ε)
#
# 在 LJ 单位下，所有物理量都是无量纲的"约化量"。
# 例如 T*=1.0 对应实际温度 119.8 K。
# ============================================================

# ---- 初始化 ----
# 清除之前可能存在的所有定义（如果从交互式命令行运行很有用）
clear

# ---- 单位制设定 ----
# 使用 Lennard-Jones 约化单位（无量纲）
units lj

# ---- 原子类型 ----
# 定义模型中只有一种原子类型
atom_style atomic

# ---- 模拟盒子 ----
# 边界条件: p = periodic (周期性边界)
# x, y, z 三个方向都是周期性边界
# 粒子从盒子一边出去，会从对面一边重新进入
boundary p p p

# ---- 力场模型 ----
# 使用 Lennard-Jones 12-6 势:
#   V(r) = 4*ε*[(σ/r)^12 - (σ/r)^6]
# pair_style lj/cutoff: 标准 LJ 势，截断半径为 2.5σ
#   参数 2.5 的含义: 截断半径 = 2.5 * σ (经典推荐值)
pair_style lj/cut 2.5

# ---- 邻居列表 ----
# bin: 使用 binning 方法加速邻居搜索
# 0.3: 邻居列表的"皮肤"距离（额外延伸 0.3σ 的搜索范围）
# 每 1 步更新一次邻居列表（默认 10 步，这里显式指定便于教学）
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

# ---- 晶格与模拟盒子创建 ----
# lattice 命令: 定义晶格类型和密度
#   fcc: 面心立方 (Face-Centered Cubic) — 氩原子在低温下排列成这种结构
#   0.8442: 约化密度 ρ* = ρ*σ³ (典型 LJ 液体密度，约为氩在 85 K 的液态密度)
#   这个密度意味着每个 σ³ 的体积中有 0.8442 个原子
#   对应的原子间距大约为 1.09σ
lattice fcc 0.8442

# create_region: 定义一个盒子形状的区域
#   box: 矩形盒子
#   -4 4 -4 4 -4 4: x 方向从 -4 到 4，y 方向从 -4 到 4，z 方向从 -4 到 4
#   单位是晶格常数 (lattice spacing)，不是 σ!
#   因为 fcc 晶格常数 a = (4/ρ*)^(1/3) ≈ 1.68σ
#   所以实际盒子边长 = 8 * 1.68 ≈ 13.4σ
region simbox block -4 4 -4 4 -4 4

# create_box: 在指定区域内创建模拟盒子
#   1: 1 种原子类型
#   同时会初始化邻居列表等内部数据结构
create_box 1 simbox

# create_atoms: 在盒子内按晶格排列填充原子
#   1: 第 1 种原子类型
#   fcc 晶格下，该区域大约产生 2048 个原子 (8×8×8 个晶胞，每个 fcc 晶胞 4 个原子)
create_atoms 1 box

# ---- 质量设定 ----
# 在 LJ 单位下，质量约化为 1 (m* = m/m_ref = 39.948/39.948 = 1.0)
# 这是 LJ 无量纲化的基础之一
mass 1 1.0

# ---- 力场参数 ----
# pair_coeff: 设置原子对之间的相互作用参数
#   pair_coeff 类型i 类型j ε σ 截断半径
#   1 1: 类型 1 与类型 1 之间的相互作用（只有一种类型）
#   1.0: ε* = ε/ε_ref = 1.0 (约化能量，LJ 单位下为 1)
#   1.0: σ* = σ/σ_ref = 1.0 (约化距离，LJ 单位下为 1)
#   截断半径默认继承 pair_style 中的 2.5
pair_coeff 1 1 1.0 1.0

# ---- 热力学输出设定 ----
# thermo: 每隔多少步输出一次热力学信息到终端
thermo 100

# thermo_style: 定义输出哪些热力学量
#   step:    当前时间步
#   temp:    温度 (T*, 无量纲)
#   press:   压力 (P*, 无量纲)
#   pe:      势能 (Potential Energy, 约化单位)
#   ke:      动能 (Kinetic Energy, 约化单位)
#   etotal:  总能量 = PE + KE (应该守恒，因为 NVE)
#   density: 数密度 (ρ*, 无量纲)
thermo_style custom step temp press pe ke etotal density

# ---- 速度初始化 ----
# velocity 命令: 给所有原子赋予初始速度
#   all: 所有原子
#   create: 随机创建速度
#   1.0: 目标温度 T* = 1.0 (约化温度，对应 119.8 K)
#   12345: 随机数种子 (使用固定种子可重现结果)
#   dist gaussian: 速度服从高斯分布 (麦克斯韦-玻尔兹曼分布)
velocity all create 1.0 12345 dist gaussian

# ---- 轨迹输出 (dump) ----
# dump: 将原子轨迹输出到文件，可用 OVITO 等软件可视化
#   mydump: dump 的名字 (任意标识)
#   all: 输出所有原子
#   atom: 原子格式 (每个原子一行)
#   100: 每 100 步输出一帧
#   dump.lammpstrj: 输出文件名
#   id type x y z: 每行输出的内容 —— 原子ID、类型、坐标
dump mydump all atom 100 dump.lammpstrj

# ---- 时间积分器 ----
# fix: 对原子施加某种操作（这里是时间积分）
#   NVE: 微正则系综 (粒子数 N、体积 V、能量 E 守恒)
#   使用 Velocity-Verlet 算法积分牛顿运动方程
fix 1 all nve

# ---- 时间步长 ----
# LJ 约化时间单位: τ = σ * √(m/ε) ≈ 2.15 ps (对氩)
# dt = 0.005τ ≈ 0.01 ps ≈ 10 fs
# 这是 LJ 模拟中常用的步长（太大会导致积分不稳定）
timestep 0.005

# ---- 运行模拟 ----
# run: 执行分子动力学模拟
#   1000: 运行 1000 步
#   总模拟时间 = 1000 × 0.005τ = 5τ ≈ 10.8 ps
run 1000

# ============================================================
# 模拟结束
# 输出文件说明:
#   dump.lammpstrj - 原子轨迹文件，可用 OVITO 打开可视化
#   终端输出 - 热力学量 (温度、压力、能量等)
#
# 【单位转换提示】
# LJ 约化单位 → 实际物理单位 (以氩为例):
#   长度: 1σ = 3.405 Å
#   能量: 1ε = 1.654e-21 J = 119.8 k_B K
#   质量: 1m = 39.948 amu = 6.634e-26 kg
#   时间: 1τ = σ√(m/ε) = 2.15 ps
#   温度: T* = k_B*T/ε → T = T* × 119.8 K
#   压力: P* = P*σ³/ε → P = P* × 41.9 MPa
#   密度: ρ* = ρ*σ³ → ρ = ρ*/σ³ = ρ* × 2.548e28 m⁻³
# ============================================================
