# ============================================================
# LAMMPS 输入脚本: 金属单位 (Metal Units)
# 模拟体系: 类氩流体 (Argon-like fluid) — 与前两个脚本相同的物理系统
# 单位制: metal
# ============================================================
#
# 【metal 单位制的含义】
# metal 是固体物理和材料科学中最常用的单位制:
#   - 质量: g/mol (与 real 相同)
#   - 距离: Å (埃，与 real 相同)
#   - 时间: ps (皮秒，1 ps = 1e-12 s) ← 注意! 与 real 不同!
#   - 能量: eV (电子伏特，1 eV = 1.602e-19 J) ← 注意! 与 real 不同!
#   - 速度: Å/ps
#   - 力: eV/Å
#   - 温度: K (开尔文)
#   - 压力: bar (巴，1 bar = 1e5 Pa)
#
# 【metal 与 real 的关键区别】
#   - 时间单位: real 用 fs, metal 用 ps
#   - 能量单位: real 用 kcal/mol, metal 用 eV
#   - 压力单位: real 用 atm, metal 用 bar
#
# 【能量单位换算】
#   1 eV = 96.485 kJ/mol = 23.06 kcal/mol
#   1 kcal/mol = 0.04336 eV
#   k_B = 8.617e-5 eV/K (玻尔兹曼常数)
#
# 【与 LJ 单位的转换关系 (以氩为例)】
#   1σ = 3.405 Å (不变)
#   1ε = 0.01032 eV (= 119.8 K × 8.617e-5 eV/K)
#   1m = 39.948 g/mol (不变)
#   1τ = 2.157 ps (注意: 在 metal 中时间就是 ps)
#   T* = 1.0 对应 T = 119.8 K
#   dt = 0.005τ = 0.01079 ps ≈ 0.01 ps
# ============================================================

# ---- 初始化 ----
clear

# ---- 单位制设定 ----
# metal 单位制: g/mol, Å, ps, eV, K, bar
units metal

# ---- 原子类型 ----
atom_style atomic

# ---- 模拟盒子 ----
# 与前两个脚本完全相同的周期性边界
boundary p p p

# ---- 力场模型 ----
# 截断半径 = 2.5σ = 2.5 × 3.405 = 8.5125 Å (与 real 相同)
pair_style lj/cut 8.5125

# ---- 邻居列表 ----
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

# ---- 晶格与模拟盒子创建 ----
# 【重要】在 real 和 metal 单位制中，lattice 命令的参数是晶格常数 (Å)，
# 而不是密度! (与 lj 单位制不同)
# 晶格常数 a = (4/ρ)^(1/3)，其中 ρ = 0.02138 原子/ų
# a = (4/0.02138)^(1/3) ≈ 5.72 Å
lattice fcc 5.72
region simbox block 0 8 0 8 0 8
create_box 1 simbox
create_atoms 1 box

# ---- 质量设定 ----
# metal 单位中质量单位也是 g/mol (与 real 相同)
mass 1 39.948

# ---- 力场参数 ----
# ε 的单位变了!
#   real: ε = 0.2381 kcal/mol
#   metal: ε = 0.01032 eV
#
# 【换算验证】
#   0.2381 kcal/mol × 0.04336 eV/(kcal/mol) = 0.01032 eV ✓
#   119.8 K × 8.617e-5 eV/K = 0.01032 eV ✓
#
# σ = 3.405 Å (单位相同，数值不变)
pair_coeff 1 1 0.01032 3.405

# ---- 热力学输出设定 ----
thermo 100

# 输出热力学量:
#   temp:    温度 (K)
#   press:   压力 (bar) — 注意! metal 用 bar, real 用 atm
#   pe:      势能 (eV) — 注意! metal 用 eV, real 用 kcal/mol
#   ke:      动能 (eV)
#   etotal:  总能量 (eV)
#   density: 质量密度 (g/cm³)
thermo_style custom step temp press pe ke etotal density

# ---- 速度初始化 ----
# 温度 = 119.8 K (与前两个脚本相同)
# 注意: 金属单位制中温度单位是 K，与 real 相同
velocity all create 119.8 12345 dist gaussian

# ---- 轨迹输出 ----
dump mydump all atom 100 dump_metal.lammpstrj

# ---- 时间积分器 ----
fix 1 all nve

# ---- 时间步长 ----
# metal 单位中时间单位是 ps
# dt = 0.005τ ≈ 0.01 ps = 10 fs
# 与 real 中的 10.0 fs 物理上完全相同!
timestep 0.01

# ---- 运行模拟 ----
# 1000 步 × 0.01 ps = 10 ps
# 与前两个脚本的总模拟时间相同
run 1000

# ============================================================
# 模拟结束
# 【三种单位制全面对比】
#
# 物理量       | LJ (lj)       | Real (real)    | Metal (metal)
# ------------ | ------------- | -------------- | -------------
# 质量         | 1.0 (无量纲)  | 39.948 g/mol   | 39.948 g/mol
# 距离         | 1.0 (无量纲)  | 3.405 Å        | 3.405 Å
# 能量 ε       | 1.0 (无量纲)  | 0.2381 kcal/mol| 0.01032 eV
# 时间步长     | 0.005 (无量纲)| 10.0 fs        | 0.01 ps
# 温度         | 1.0 (无量纲)  | 119.8 K        | 119.8 K
# 截断半径     | 2.5 (无量纲)  | 8.5125 Å       | 8.5125 Å
# 晶格常数   | ~1.68 (σ单位) | 5.72 Å         | 5.72 Å
# 约化密度   | 0.8442        | 0.02138 原子/ų | 0.02138 原子/ų
#
# 三者描述完全相同的物理系统，只是"尺子"不同!
# ============================================================
