# ============================================================
#  LAMMPS NVT 系综模拟教程
#  目的：演示 Nosé-Hoover 恒温器控制温度的方法
#        先用 NVE 平衡，再切换到 NVT，最后演示温度斜坡
#  运行命令：lmp -in in.nvt
# ============================================================

# ============================================================
#  第一部分：系统初始化和建模
# ============================================================

# 使用 LJ 约化单位制（m = σ = ε = k_B = 1）
units           lj

# 原子样式：最简单的点粒子
atom_style      atomic

# 创建 FCC 格子，密度 0.8442（LJ 液态三相点附近的标准密度）
lattice         fcc 0.8442

# 模拟盒子：8×8×8 个晶格周期，约 2048 个原子
region          box block 0 8 0 8 0 8
create_box      1 box
create_atoms    1 box

# LJ 势函数，截断半径 2.5σ
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# 原子质量 = 1（LJ 单位）
mass            1 1.0

# ============================================================
#  第二部分：速度初始化
# ============================================================

# 给所有原子分配初始速度，目标温度 T = 1.0
#   create — 从零开始创建速度分布
#   1.0    — 目标温度（LJ 约化单位）
#   54321  — 随机数种子（不同种子 → 不同的初始速度分布）
#   mom yes — 移除总动量，防止整个系统"漂移"
#   rot yes — 移除总角动量
velocity        all create 1.0 54321 mom yes rot yes

# ============================================================
#  第三部分：NVE 预平衡（短时间）
# ============================================================

# 为什么要先跑 NVE？
#   初始速度是从理想 Maxwell-Boltzmann 分布随机采样的
#   但原子位置是完美的晶格，两者不自洽
#   先用 NVE 跑一小段，让系统"自洽"地松弛一下
#   这样后续 NVT 的温度会更稳定

print           ""
print           "=========================================="
print           "  第一阶段：NVE 预平衡（1000 步）"
print           "  让初始构型自洽松弛"
print           "=========================================="
print           ""

# 时间步长 0.005（LJ 时间单位）
timestep        0.005

# NVE 系综：能量守恒，不控制温度
fix             1 all nve

# 热力学输出：每 10 步输出一次
thermo          10

# 输出步数、温度、势能、动能、总能量
thermo_style    custom step temp pe ke etotal press

# 跑 500 步 NVE 预平衡
run             500

# 删除 NVE 的 fix，为切换到 NVT 做准备
unfix           1

# ============================================================
#  第四部分：NVT 恒温模拟（Nosé-Hoover 恒温器）
# ============================================================

# Nosé-Hoover 恒温器是最常用的温度控制方法之一
# 它在运动方程中引入一个额外的"热浴"变量 ζ
# 该变量会自动调节原子速度，使系统温度趋向目标值
#
# fix 1 all nvt temp T_start T_stop T_damp
#   1        — fix 的名称（用户自定义）
#   all      — 作用于所有原子
#   nvt      — Nosé-Hoover NVT 恒温器
#   temp T_start T_stop T_damp:
#     T_start = 1.0 — 初始目标温度
#     T_stop  = 1.0 — 最终目标温度（与 T_start 相同 → 恒温）
#     T_damp  = 0.5 — 热浴弛豫时间参数
#                     控制温度调节的"快慢"
#                     太小 → 温度剧烈振荡
#                     太大 → 温度收敛太慢
#                     经验值：100*dt ~ 1000*dt（此处 0.5 约为 100*0.005）

print           ""
print           "=========================================="
print           "  第二阶段：NVT 恒温模拟（5000 步）"
print           "  使用 Nosé-Hoover 恒温器"
print           "  目标温度 T = 1.0"
print           "  热浴弛豫时间 T_damp = 0.5"
print           "=========================================="
print           ""

# 设置 Nosé-Hoover NVT 恒温器
fix             1 all nvt temp 1.0 1.0 0.5

# 热力学输出：每 100 步输出一次（便于观察温度收敛过程）
thermo          100
thermo_style    custom step temp pe ke etotal press

# 轨迹输出：每 500 步写一帧
# 用 OVITO 等可视化软件可以观察原子运动
dump            1 all custom 500 dump.nvt.lammpstrj id type x y z vx vy vz
dump_modify     1 sort id

# 跑 5000 步 NVT
run             5000

# 保存最终构型
write_restart   restart.nvt

# 关闭当前 fix 和 dump，为下一段做准备
unfix           1
undump          1

# ============================================================
#  第五部分：温度斜坡 — 从 0.5 升温到 2.0
# ============================================================

# 温度斜坡的用途：
#   - 模拟退火（annealing）过程
#   - 研究相变行为（如 LJ 液体的汽化）
#   - 逐步升温观察系统的热力学响应
#
# 当 T_start ≠ T_stop 时，NVT 恒温器会线性地将目标温度
# 从 T_start 变化到 T_stop，整个过程经历 run 步数

print           ""
print           "=========================================="
print           "  第三阶段：温度斜坡模拟（5000 步）"
print           "  从 T = 0.5 线性升温到 T = 2.0"
print           "  可观察系统随温度升高的变化"
print           "=========================================="
print           ""

# 先重设速度，匹配新的起始温度 0.5
velocity        all create 0.5 98765 mom yes rot yes

# NVT 温度斜坡：
#   T_start = 0.5 → T_stop = 2.0
#   每步目标温度线性增加 (2.0 - 0.5) / 5000 ≈ 3e-4
fix             1 all nvt temp 0.5 2.0 0.5

# 每 200 步输出一次热力学信息
thermo          200
thermo_style    custom step temp pe ke etotal press

# 轨迹输出
dump            1 all custom 1000 dump.ramp.lammpstrj id type x y z vx vy vz
dump_modify     1 sort id

# 跑 5000 步温度斜坡
run             5000

unfix           1
undump          1

# ============================================================
#  总结输出
# ============================================================

print           ""
print           "=========================================="
print           "  全部模拟完成！"
print           ""
print           "  输出文件："
print           "    dump.nvt.lammpstrj  — NVT 恒温轨迹（T=1.0）"
print           "    dump.ramp.lammpstrj — 温度斜坡轨迹（0.5→2.0）"
print           "    restart.nvt         — NVT 平衡后重启文件"
print           ""
print           "  观察要点："
print           "    1. NVT 阶段：温度是否收敛到 1.0？"
print           "    2. 温度涨落有多大？（与原子数相关）"
print           "    3. 斜坡阶段：势能如何随温度变化？"
print           "    4. 用 OVITO 观察高温下原子排列的变化"
print           "=========================================="
