# ============================================================
#  最小化算法比较：共轭梯度法 (CG) vs 最速下降法 (SD)
#  目的：使用相同的初始构型，比较两种算法的收敛行为
# =================================================================
#
# 为什么需要比较不同算法？
#   不同算法收敛速度不同，选择合适的算法可以节省大量计算时间
#   本脚本用完全相同的初始构型，分别用 CG 和 SD 两种算法最小化
#   通过对比日志文件，可以直观看到它们的差异
#
# 思考题：FIRE 算法需要更小的初始扰动或不同的参数设置
#         可以在练习中自行尝试
# =================================================================

# =================================================================
#  第一部分：使用共轭梯度法 (Conjugate Gradient) 最小化
# =================================================================

# --- 初始化 ---
units           lj
atom_style      atomic

# 创建 FCC 格子（5x5x5 个晶胞，约 500 个原子）
lattice         fcc 1.0
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

# LJ 势函数
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
mass            1 1.0

# 制造重叠构型：随机偏移所有原子
# 使用随机种子 12345，确保两种算法的初始条件完全一致
# 这样比较才公平！
group           allatoms type 1
displace_atoms  allatoms random 0.2 0.2 0.2 12345

# --- CG 最小化 ---
print           ""
print           "=========================================="
print           "  方法 1：共轭梯度法 (Conjugate Gradient)"
print           "=========================================="

min_style       cg
min_modify      dmax 0.1

# 使用 log 命令将 CG 的输出保存到单独的日志文件
# 这样可以用 log.cg 和 log.sd 分别查看
log             log.cg

# 详细输出每步信息
thermo          1
thermo_style    custom step pe ke etotal fmax fnorm

# 运行 CG 最小化
minimize        1.0e-6 1.0e-6 10000 100000

print           ""
print           "=========================================="
print           "  CG 最小化完成"
print           "=========================================="

# =================================================================
#  第二部分：使用最速下降法 (Steepest Descent) 最小化
# =================================================================

# 为了公平比较，需要重置到完全相同的初始构型
# clear 命令会清除所有设置，从头开始
clear

# 重新初始化（和上面完全相同的设置）
units           lj
atom_style      atomic

lattice         fcc 1.0
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
mass            1 1.0

# 制造完全相同的重叠构型（相同的随机种子！）
group           allatoms type 1
displace_atoms  allatoms random 0.2 0.2 0.2 12345

# --- SD 最小化 ---
print           ""
print           "=========================================="
print           "  方法 2：最速下降法 (Steepest Descent)"
print           "=========================================="

# 切换到最速下降法
min_style       sd

# 保存到另一个日志文件
log             log.sd

# 详细输出
thermo          1
thermo_style    custom step pe ke etotal fmax fnorm

# 运行 SD 最小化（使用相同的收敛条件）
minimize        1.0e-6 1.0e-6 10000 100000

print           ""
print           "=========================================="
print           "  SD 最小化完成"
print           "=========================================="

# =================================================================
#  总结输出
# =================================================================
print           ""
print           "=========================================="
print           "  两种算法比较完成！"
print           ""
print           "  日志文件（用文本编辑器或 grep 查看）："
print           "    log.cg   — 共轭梯度法结果"
print           "    log.sd   — 最速下降法结果"
print           ""
print           "  比较要点："
print           "    1. 迭代步数：哪种算法步数最少？"
print           "    2. 最终能量：两种方法是否收敛到相同的能量？"
print           "    3. 收敛速度：哪种算法在前期下降最快？"
print           "    4. 力的收敛：Fnorm 下降的趋势有何不同？"
print           ""
print           "  练习：尝试 min_style fire（需要更小的初始偏移）"
print           "=========================================="
